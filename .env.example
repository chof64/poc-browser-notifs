# Copy to .dev.vars for local dev (`wrangler dev` reads .dev.vars, never commit secrets).
# Vars vs secrets match wrangler.toml / dashboard: [vars] = variable, secret = dashboard/secret put.

# --- Variables (non-secret, go in wrangler.toml [vars]) ---
# Public key, served to browsers via /api/vapid-public-key.
VAPID_PUBLIC_KEY=
# Contact for push service (mailto: or https: URL).
VAPID_SUBJECT=mailto:you@example.com

# --- Secrets (never in wrangler.toml; set via dashboard or `wrangler secret put`) ---
VAPID_PRIVATE_KEY=
